{
  "name": "@mediumofexchange/reference",
  "version": "0.1.0",
  "description": "Reference implementation of the Medium of Exchange Protocol: one backing object B = (K, P, R, E), claims held against it, wallets, and the law.",
  "keywords": [
    "money",
    "credit",
    "medium-of-exchange",
    "protocol",
    "reference-implementation",
    "bearer-claims",
    "mutual-credit",
    "ed25519"
  ],
  "homepage": "https://mediumofexchange.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediumofexchange/reference-ts.git"
  },
  "bugs": {
    "url": "https://github.com/mediumofexchange/reference-ts/issues"
  },
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/pool/circuits",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-links.mjs .",
    "check:ergo:range": "npm --prefix experiments/ergo-range run check",
    "check:package": "node scripts/check-package.mjs",
    "check:pilot": "node scripts/pilot-demo.mjs",
    "pilot:demo": "npm run build && npm run check:pilot",
    "check:pool": "npm run build && node scripts/pool/prepare-crs.mjs && node scripts/pool/check.mjs",
    "check:pool:v3": "npm run build && node scripts/pool/prepare-crs.mjs && node scripts/pool/v3/check.mjs && node scripts/pool/v3/local-check.mjs",
    "check:pool:local-replay": "npm run build && node scripts/pool/prepare-crs.mjs && node scripts/pool/v3/local-check.mjs",
    "bench:pool:prepare": "node scripts/pool/browser/prepare.mjs",
    "bench:pool:browser": "node scripts/pool/browser/serve.mjs",
    "check:pool-store": "node scripts/pool/store-crash.mjs",
    "check:pool-service": "node scripts/pool/service/check.mjs",
    "check:pool-wallet": "node scripts/pool/wallet/check.mjs",
    "check:pool-wallet-real": "node scripts/pool/prepare-crs.mjs && node scripts/pool/wallet/check.mjs --real",
    "check:pool-local-profile": "node scripts/pool/local/profile-check.mjs && node scripts/pool/local/paths-check.mjs",
    "check:pool-local-real": "node scripts/pool/prepare-crs.mjs && node scripts/pool/local/check.mjs",
    "check:pool-wallet-crash": "node scripts/pool/wallet/crash.mjs",
    "check": "npm run check:docs && npm run typecheck && npm test && npm run build && npm run check:package && npm run check:pool-local-profile && npm run check:pilot && npm run check:pool-store && npm run check:pool-service && npm run check:pool-wallet && npm run check:pool-wallet-crash && npm run check:pool:spent",
    "prepublishOnly": "npm run check",
    "check:pool:delivery": "npm run build && node scripts/pool/delivery/check.mjs && node scripts/pool/delivery/binding/check.mjs && node scripts/pool/delivery/evidence-check.mjs",
    "check:pool:restoration": "npm run build && node scripts/pool/delivery/evidence-check.mjs",
    "check:pool:fees": "npm run build && node scripts/pool/fees/check.mjs",
    "check:pool:spent": "node scripts/pool/spent-set/check.mjs",
    "bench:pool:spent": "npm run build && node scripts/pool/spent-set/bench.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "peerDependencies": {
    "@aztec/bb.js": "5.2.0"
  },
  "peerDependenciesMeta": {
    "@aztec/bb.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aztec/bb.js": "5.2.0",
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "@noir-lang/noir_wasm": "1.0.0-beta.26",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vite": "7.3.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0"
  }
}
