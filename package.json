{
  "name": "@mediumofexchange/reference",
  "version": "0.1.0",
  "description": "Reference implementation of the Medium of Exchange Protocol: one backing object B = (K, P, R, E), claims held against it, wallets, and the law.",
  "keywords": [
    "money",
    "credit",
    "medium-of-exchange",
    "protocol",
    "reference-implementation",
    "bearer-claims",
    "mutual-credit",
    "ed25519"
  ],
  "homepage": "https://mediumofexchange.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediumofexchange/reference-ts.git"
  },
  "bugs": {
    "url": "https://github.com/mediumofexchange/reference-ts/issues"
  },
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/pool/circuits",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-links.mjs .",
    "check:package": "node scripts/check-package.mjs",
    "check:pilot": "node scripts/pilot-demo.mjs",
    "pilot:demo": "npm run build && npm run check:pilot",
    "check:privacy": "npm run build && npm --prefix experiments/private-payment run check",
    "check:pool": "node scripts/pool/check.mjs",
    "check": "npm run check:docs && npm run typecheck && npm test && npm run build && npm run check:package && npm run check:pilot",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "devDependencies": {
    "@aztec/bb.js": "5.2.0",
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "@noir-lang/noir_wasm": "1.0.0-beta.26",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0"
  }
}
