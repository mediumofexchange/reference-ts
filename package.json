{
  "name": "@mediumofexchange/reference",
  "version": "0.1.0",
  "description": "Reference implementation of the Medium of Exchange Protocol: one backing object B = (K, P, R, E), claims held against it, wallets, and the law.",
  "keywords": [
    "money",
    "credit",
    "medium-of-exchange",
    "protocol",
    "reference-implementation",
    "bearer-claims",
    "mutual-credit",
    "ed25519"
  ],
  "homepage": "https://mediumofexchange.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediumofexchange/reference-ts.git"
  },
  "bugs": {
    "url": "https://github.com/mediumofexchange/reference-ts/issues"
  },
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0"
  }
}
