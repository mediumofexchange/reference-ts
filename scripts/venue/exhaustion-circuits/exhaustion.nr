// What every exhaustion circuit of succinct-read §4.3 shares: the domain tags, the state the leaves carry from one
// to the next and its hash, the digests and small constrained helpers. Each leaf, the node and the two folds is its
// own project (`main.nr`, generated by scripts/venue/exhaustion-set.mjs) with this module, `blake2b.nr` and the
// vendored sponge beside it.
use crate::poseidon2::Poseidon2;

// succinct-read §2's tags: §4.2's map digests, then the three that join the exhaustion's proofs.
pub global T_ENTRY: Field = 1010;
pub global T_MAP_LEAF: Field = 1011;
pub global T_MAP_NODE: Field = 1012;
pub global T_EX_ID: Field = 1013;
pub global T_EX_STATE: Field = 1014;
pub global T_EX_CHALLENGE: Field = 1015;
// Every proof under pool-v3 §4's backend and verifier target is 458 field elements and every key 115; HONK_ZK is the
// pinned backend's identifier of that proof type (as the trail circuits).
pub global PROOF_FIELDS: u32 = 458;
pub global KEY_FIELDS: u32 = 115;
pub global HONK_ZK: u32 = 6;
// The map's depth (§4.2) and the tree machine's stack: two sentinel positions below S live entries, enough for a
// section of 2^17 leaves.
pub global D: u32 = 32;
pub global S: u32 = 18;
pub global P32: Field = 4294967296;
pub global P64: Field = 18446744073709551616;
pub global P128: Field = 340282366920938463463374607431768211456;

/// The transaction stream's state: the open transaction's Blake2b chaining value and byte count, the scan's
/// registers (src/ergo-scan.ts), the labels of the transaction scanned last (its block's height and its position),
/// the chain of finished transactions' ids with their labels (T_EX_ID) and the chain of the entries listed (T_ENTRY).
pub struct T {
    pub h: [u64; 8], pub t: u64, pub in_tx: bool,
    pub mode: u32, pub r: Field, pub c1: Field, pub c2: Field, pub a: Field, pub p: Field,
    pub hi: Field, pub lo: Field, pub sh: Field, pub outi: Field,
    pub height: Field, pub j: Field, pub chain: Field, pub echain: Field,
}
/// The tree-and-header stream's state: the last header's id and height, the open header's chaining value and byte
/// count, the position of the next id pushed, the tree machine's stack and pointer, and the chain of ids pushed with
/// their labels (T_EX_ID).
pub struct M {
    pub prev: [u64; 4], pub height: Field, pub mh: [u64; 8], pub hc: u64, pub in_hdr: bool, pub j: Field,
    pub stack: [[u64; 4]; S + 2], pub sp: u32, pub chain: Field,
}
/// The map stream's state: the chain of the entries applied (T_ENTRY) and the map's root.
pub struct U { pub chain: Field, pub root: Field }

fn pack3(w: [u64; 3]) -> Field { w[0] as Field + w[1] as Field * P64 + w[2] as Field * P128 }
global STATE_INPUTS: u32 = 1 + 18 + 9 + 2 * (S + 2) + 3;
/// H(T_EX_STATE, ...) over the three streams' state; words are packed three to an element, each below 2^64.
pub fn state_hash(t: T, m: M, u: U) -> Field {
    let mut f = [0; STATE_INPUTS];
    f[0] = T_EX_STATE;
    f[1] = pack3([t.h[0], t.h[1], t.h[2]]);
    f[2] = pack3([t.h[3], t.h[4], t.h[5]]);
    f[3] = pack3([t.h[6], t.h[7], t.t]);
    f[4] = t.in_tx as Field;
    f[5] = t.mode as Field;
    f[6] = t.r;
    f[7] = t.c1;
    f[8] = t.c2;
    f[9] = t.a;
    f[10] = t.p;
    f[11] = t.hi;
    f[12] = t.lo;
    f[13] = t.sh;
    f[14] = t.outi;
    f[15] = t.height;
    f[16] = t.j;
    f[17] = t.chain;
    f[18] = t.echain;
    f[19] = pack3([m.prev[0], m.prev[1], m.prev[2]]);
    f[20] = pack3([m.prev[3], m.hc, 0]);
    f[21] = m.height;
    f[22] = pack3([m.mh[0], m.mh[1], m.mh[2]]);
    f[23] = pack3([m.mh[3], m.mh[4], m.mh[5]]);
    f[24] = pack3([m.mh[6], m.mh[7], 0]);
    f[25] = m.in_hdr as Field;
    f[26] = m.j;
    f[27] = m.sp as Field;
    for i in 0..S + 2 {
        let w = m.stack[i];
        f[28 + 2 * i] = pack3([w[0], w[1], w[2]]);
        f[29 + 2 * i] = w[3] as Field;
    }
    f[STATE_INPUTS - 3] = m.chain;
    f[STATE_INPUTS - 2] = u.chain;
    f[STATE_INPUTS - 1] = u.root;
    Poseidon2::hash(f, STATE_INPUTS)
}

/// §4.2: chain_i = H(T_ENTRY, chain_(i-1), subject.hi, subject.lo, height, position, output). The period's entry stream
/// is one such chain over every key.
pub fn entry_chain(previous: Field, hi: Field, lo: Field, height: Field, position: Field, output: Field) -> Field {
    Poseidon2::hash([T_ENTRY, previous, hi, lo, height, position, output], 7)
}
/// §4.2's leaf for a nonzero count.
pub fn map_leaf(count: Field, chain: Field) -> Field { Poseidon2::hash([T_MAP_LEAF, count, chain], 3) }
pub fn map_node(left: Field, right: Field) -> Field { Poseidon2::hash([T_MAP_NODE, left, right], 3) }
/// A transaction id, as its four little-endian Blake2b words packed two to an element, with its block's height and
/// its position, joined to the id chain.
pub fn id_chain(previous: Field, id: [u64; 4], height: Field, position: Field) -> Field {
    let a = id[0] as Field + id[1] as Field * P64;
    let b = id[2] as Field + id[3] as Field * P64;
    Poseidon2::hash([T_EX_ID, previous, a, b, height, position], 6)
}

unconstrained fn inverse(x: Field) -> Field { if x == 0 { 0 } else { 1 / x } }
/// 1 where x is zero, else 0.
pub fn is_zero(x: Field) -> Field {
    // Safety: z = 1 - x inv with x z = 0, so z is 1 exactly where x is 0.
    let inv = unsafe { inverse(x) };
    let z = 1 - x * inv;
    assert(x * z == 0);
    z
}
unconstrained fn as_index(v: Field) -> u32 { v as u32 }
/// x as a u32, which it must be.
pub fn index(x: Field) -> u32 {
    // Safety: the u32 is constrained equal to x.
    let i = unsafe { as_index(x) };
    assert(i as Field == x);
    i
}
unconstrained fn prefix(n: Field, i: u32) -> bool { (i as Field).lt(n) }
/// act[j] = (j < n) for n in [0, 128]: non-increasing bits summing to n.
pub fn mask(n: Field) -> [Field; 128] {
    let mut out = [0; 128];
    let mut sum: Field = 0;
    let mut was: Field = 1;
    for j in 0..128 {
        // Safety: the bits are constrained boolean, non-increasing, and to sum to n.
        let b = unsafe { prefix(n, j) } as Field;
        assert(b * (1 - was) == 0);
        was = b;
        sum += b;
        out[j] = b;
    }
    assert(sum == n);
    out
}
/// The little-endian 64-bit word at byte offset o.
pub fn le_word(b: [u8; 128], o: u32) -> Field {
    let mut w: Field = 0;
    for i in 0..8 {
        w = w * 256 + b[o + 7 - i] as Field;
    }
    w
}
/// Where on is 1, the 32 bytes at offset o spell the id whose little-endian words are d; `what` names the check.
pub fn spells<let N: u32>(on: Field, b: [u8; 128], o: u32, d: [u64; 4], what: str<N>) {
    for k in 0..4 {
        assert(on * (le_word(b, o + 8 * k) - d[k] as Field) == 0, what);
    }
}
/// pool-v2 §1's limbs (hi, lo) of the 32-byte id whose little-endian Blake2b words are d: its bytes, first to last,
/// read big-endian in two halves.
pub fn id_limbs(d: [u64; 4]) -> (Field, Field) {
    let mut limbs = [0; 2];
    for k in 0..4 {
        let bytes: [u8; 8] = (d[k] as Field).to_le_bytes();
        for i in 0..8 {
            limbs[k / 2] = limbs[k / 2] * 256 + bytes[i] as Field;
        }
    }
    (limbs[0], limbs[1])
}

/// Whether two states are those of a period's start: no transaction or header open, the stack empty, the next id at
/// position zero, both streams at one header and every chain empty.
pub fn assert_start(t: T, m: M, u: U) {
    assert(!t.in_tx, "period start");
    assert(!m.in_hdr, "period start");
    assert(m.sp == 0, "period start");
    assert(m.j == 0, "period start");
    assert(t.height == m.height, "period start");
    assert(t.chain == 0, "period start");
    assert(m.chain == 0, "period start");
    assert(t.echain == 0, "period start");
    assert(u.chain == 0, "period start");
}
/// Whether a state is a period's end: both streams at one block boundary, with one chain of ids and labels, and every
/// entry listed applied to the map.
pub fn assert_end(t: T, m: M, u: U) {
    assert(!t.in_tx, "period end");
    assert(!m.in_hdr, "period end");
    assert(m.sp == 0, "period end");
    assert(t.height == m.height, "period end");
    assert(t.chain == m.chain, "period end");
    assert(t.echain == u.chain, "period end");
}
