// What every trail circuit of succinct-read §3.2 shares: the domain tags, the
// proof shape, pool-v3 §7's proofHash and the digests. Each leaf and the node
// is its own project (`main.nr`, generated by scripts/pool/v3/check-set.mjs)
// with this module and the vendored sponge beside it.
use crate::poseidon2::Poseidon2;

// succinct-read §2's tags, after pool-v3 §2's T_TAG.
pub global T_CHECK_LEAF: Field = 1008;
pub global T_CHECK_NODE: Field = 1009;
// Every proof under pool-v3 §4's backend and verifier target is 458 field
// elements (14,656 bytes), a statement proof and a check proof alike, and
// every key 115.
pub global PROOF_FIELDS: u32 = 458;
pub global KEY_FIELDS: u32 = 115;
// The pinned backend's identifier of an UltraHonk proof with zero knowledge
// under the noir-recursive target, which pool-v3 §4 proves under.
pub global HONK_ZK: u32 = 6;

// The field's modulus p as eight 32-bit words, most significant first.
global MODULUS_WORDS: [u32; 8] = [
    0x30644e72, 0xe131a029, 0xb85045b6, 0x8181585d, 0x2833e848, 0x79b97091, 0x43e1f593, 0xf0000001,
];

/// An element's eight 32-bit big-endian words, unconstrained; `words_of`
/// constrains them.
unconstrained fn word_hint(x: Field) -> [u32; 8] {
    let bytes: [u8; 32] = x.to_be_bytes();
    let mut words = [0 as u32; 8];
    for j in 0..8 {
        words[j] = ((bytes[4 * j] as u32) << 24)
            + ((bytes[4 * j + 1] as u32) << 16)
            + ((bytes[4 * j + 2] as u32) << 8)
            + (bytes[4 * j + 3] as u32);
    }
    words
}

/// An element's canonical 32 big-endian bytes as eight 32-bit words: each
/// word range-checked by its type, the words below p as a 256-bit integer, and
/// their value the element. Below p, the integer they form is the element's
/// unique representative, so these are the bytes the host reads.
fn words_of(x: Field) -> [u32; 8] {
    // Safety: every word is a u32 and the words are constrained below p and to x.
    let words = unsafe { word_hint(x) };
    let mut value: Field = 0;
    let mut below = false;
    let mut equal = true;
    for j in 0..8 {
        (words[j] as Field).assert_max_bit_size::<32>();
        value = value * 4294967296 + words[j] as Field;
        below = below | (equal & (words[j] < MODULUS_WORDS[j]));
        equal = equal & (words[j] == MODULUS_WORDS[j]);
    }
    assert(below);
    assert(value == x);
    words
}

/// pool-v3 §7's proofHash of a proof's exact bytes, SHA-256 over its 458
/// elements each as 32 canonical big-endian bytes, as pool-v2 §1's two
/// 128-bit limbs (high, low): no word of p or more is ever hashed.
pub fn proof_hash(proof: [Field; PROOF_FIELDS]) -> (Field, Field) {
    // 14,656 bytes are 229 whole blocks of sixteen words; padding takes a 230th.
    let mut message = [0 as u32; 230 * 16];
    for i in 0..PROOF_FIELDS {
        let words = words_of(proof[i]);
        for j in 0..8 {
            message[8 * i + j] = words[j];
        }
    }
    message[3664] = 0x80000000;
    // The message length in bits, 117,248, in the last 64 bits.
    message[230 * 16 - 1] = 117248;
    let mut state: [u32; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
        0x5be0cd19,
    ];
    for i in 0..230 {
        let mut block = [0 as u32; 16];
        for j in 0..16 {
            block[j] = message[16 * i + j];
        }
        state = std::hash::sha256_compression(block, state);
    }
    let w: [Field; 8] = state.map(|x: u32| x as Field);
    let high = ((w[0] * 4294967296 + w[1]) * 4294967296 + w[2]) * 4294967296 + w[3];
    let low = ((w[4] * 4294967296 + w[5]) * 4294967296 + w[6]) * 4294967296 + w[7];
    (high, low)
}

/// §3.2: nodeDigest(a, b) = H(T_CHECK_NODE, a, b).
pub fn node_digest(left: Field, right: Field) -> Field {
    Poseidon2::hash([T_CHECK_NODE, left, right], 3)
}
