// z_32, the empty map's root (§4.2).
global EMPTY_ROOT: Field = 0x2ba93abef7d14e3e4509bd040c861f7a110d4bd5993263940d454dffb8dda344;

fn main(
    start_hi: pub Field, start_lo: pub Field, start_height: pub Field, end_hi: pub Field, end_lo: pub Field,
    end_height: pub Field, map_root: pub Field, fold_key_hash: pub Field,
    key: [Field; KEY_FIELDS], proof: [Field; PROOF_FIELDS], key_hash: Field, t0: T, m0: M, u0: U, t1: T, m1: M, u1: U,
